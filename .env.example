# Copie para .env.local após `npm run db:start` (valores em `npm run db:status`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_URL=http://localhost:5173

# E-mail (seed e Edge Function cfg-auth)
EMAIL_PROVIDER=console
EMAIL_FROM=VERUM <noreply@localhost>
RESEND_API_KEY=

# Primeiro sócio (somente `BOOTSTRAP_ONLY=1 npm run db:seed`)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NOME=

# Opcional: rotaciona a chave de CPF/telefone se a tabela cfg_secrets ainda estiver vazia
CFG_ENCRYPTION_KEY=

# Em produção (projeto Supabase na nuvem):
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # só no seed/functions — nunca no frontend
# EMAIL_PROVIDER=resend
# SESSION: gerenciada pelo Supabase Auth (JWT). Não há SESSION_SECRET nesta stack.
